# your EC2 public IP (sslip.io wildcard DNS = no DNS setup, Caddy auto-issues Let's Encrypt certs)
DOMAIN=YOUR_PUBLIC_IP.sslip.io
POSTGRES_PASSWORD=change-me-strong
BACKEND_SECRET=change-me-strong
# NASA FIRMS API key (https://firms.modaps.eosdis.nasa.gov/api/) - required for /firms/ingest
# FIRMS_MAP_KEY=
# Google OAuth for the API (id_token verified against Google JWKS)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://api.${DOMAIN}/api/auth/google/callback
# APP_URL=/
