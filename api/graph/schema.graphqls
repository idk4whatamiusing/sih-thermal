# Meridian GraphQL schema - the ONLY browser-facing surface (raw fetch + graphql-ws).
# Auth rides the `session` HttpOnly cookie on POST, and connection_params.session
# on the graphql-transport-ws handshake.

type User {
  id: ID!
  email: String!
}

type Source {
  id: ID!
  title: String
  text: String!
  score: Float!
}

type ChatChunk {
  delta: String!
  done: Boolean!
  sources: [Source!]!
  cached: Boolean!
}

type ChatReply {
  reply: String!
  model: String!
  sources: [Source!]!
  cached: Boolean!
}

type ChatSession {
  id: ID!
  title: String!
  pinned: Boolean!
  updatedAt: String!
}

type Message {
  role: String!
  content: String!
  createdAt: String!
}

type FirmsPoint {
  id: ID!
  latitude: Float!
  longitude: Float!
  acqDate: String!
  acqTime: String!
  brightTi4: Float!
  brightTi5: Float!
  frp: Float!
  confidence: String!
  satellite: String!
  landcover: Int!
  distIndustrialM: Float!
  insideIndustrial: Boolean!
  osmId: String!
  persistenceScore: Float!
  predictedClass: String!
  industrialProb: Float!
  clusterId: ID
}

type ThermalCluster {
  id: ID!
  centroidLat: Float!
  centroidLon: Float!
  count: Int!
  avgFrp: Float!
  maxFrp: Float!
  persistence: Float!
  firstSeen: String!
  lastSeen: String!
  predictedClass: String!
  osmId: String
}

input BoundingBox {
  minLat: Float!
  minLon: Float!
  maxLat: Float!
  maxLon: Float!
}

type Query {
  me: User
  users(limit: Int = 50): [User!]!          # gRPC -> db (Rust), cached in Redis 7d
  health: String!
  chatSessions: [ChatSession!]!             # sidebar list (per user)
  chatHistory(sessionId: ID!): [Message!]!  # Redis fast path, Postgres primary
  # PS162 FIRMS: bbox-filtered reads, cached in Redis by bbox+date+class hash
  firmsPoints(bbox: BoundingBox!, dateFrom: String, dateTo: String, predictedClass: String, limit: Int = 500): [FirmsPoint!]!
  thermalClusters(bbox: BoundingBox!): [ThermalCluster!]!
}

type FirmsClassification {
  predictedClass: String!
  industrialProb: Float!
  persistence: Float!
  reasons: [String!]!
}

input ClassifyFirmsPointInput {
  lat: Float!
  lon: Float!
  frp: Float
  brightTi4: Float
  brightTi5: Float
  confidence: String
  satellite: String
  distIndustrialM: Float
  insideIndustrial: Boolean
  persistence: Float
  landcover: Int
}

input FirmsPointInput {
  id: ID!
  latitude: Float!
  longitude: Float!
  acqDate: String!
  acqTime: String
  brightTi4: Float!
  brightTi5: Float!
  frp: Float!
  confidence: String!
  satellite: String!
  brightT31: Float
  scan: Float
  track: Float
}

type Mutation {
  login(email: String!): User!              # dev login, sets session cookie
  logout: Boolean!
  broadcast(message: String!): Boolean!     # local hub + gRPC Realtime.Broadcast
  createChatSession(title: String): ChatSession!
  renameSession(id: ID!, title: String!): Boolean!
  deleteSession(id: ID!): Boolean!
  # general chat -> ai (Cloudflare Workers AI | Bedrock | OpenAI), RAG + semantic cache
  chat(sessionId: ID!, message: String!, provider: String): ChatReply!
  # knowledge-base-only support answer (local TinyLlama Q4)
  supportQuery(message: String!): ChatReply!
  ingestSupport(documents: [String!]!): Int!
  # PS162 FIRMS: raw ingestion write-path
  upsertFirmsPoint(point: FirmsPointInput!): ID!
  updateFirmsPointClassification(id: ID!, predictedClass: String!, industrialProb: Float!, persistenceScore: Float!, distIndustrialM: Float!, insideIndustrial: Boolean!, landcover: Int!, clusterId: ID): Boolean!
  # classifies a raw point via the Python sidecar (ai gRPC -> Python /firms/predict).
  # Does not persist - call updateFirmsPointClassification with the result to store it.
  classifyFirmsPoint(input: ClassifyFirmsPointInput!): FirmsClassification!
  # triggers a FIRMS CSV pull for a bbox/date range (ai gRPC -> Python /firms/ingest); currently a stub without FIRMS_MAP_KEY
  ingestFirms(bbox: BoundingBox!, dateFrom: String!, dateTo: String!): Boolean!
}

type Subscription {
  events: String!
  chatStream(sessionId: ID!, message: String!, provider: String): ChatChunk!
  supportStream(message: String!): ChatChunk!
}
